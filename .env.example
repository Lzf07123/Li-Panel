# ============ 构建期（docker compose build 时生效） ============

# 基础镜像统一加速前缀：python 与 node 两个基础镜像共用同一个源
# 官方：docker.io/library
# 国内示例：docker.m.daocloud.io/library  或  mirror.ccs.tencentyun.com/library
IMAGE_REGISTRY=docker.io/library

# apt 源主机名（官方：deb.debian.org）
# 国内示例：mirrors.aliyun.com / mirrors.tuna.tsinghua.edu.cn / mirrors.ustc.edu.cn
APT_MIRROR=deb.debian.org

# pip / uv 包索引（官方：https://pypi.org/simple）
# 国内示例：https://pypi.tuna.tsinghua.edu.cn/simple / https://mirrors.aliyun.com/pypi/simple
PIP_INDEX_URL=https://pypi.org/simple

# npm 源（官方：https://registry.npmjs.org）
# 国内示例：https://registry.npmmirror.com
NPM_REGISTRY=https://registry.npmjs.org

# ============ 运行期 ============

# 运行环境：development（放行前端动效内联样式）/ production（严格 CSP）
ENVIRONMENT=development

# 数据目录（compose 中固定为容器内 /app/data，由 ./data 数据卷挂载）
PANEL_DATA_DIR=/app/data

# 对外端口（经 nginx 反代暴露，默认 8000；后端真实端口 8000 不直接对外开放）
PANEL_PORT=8000

# 必填：会话与流程凭证派生密钥，请改成足够长的随机字符串
PANEL_SECRET_KEY=please-change-me-to-a-long-random-string

# 是否允许访客查看公开内容（后台设置页可再改，此处为初始值）
PANEL_PUBLIC_MODE=true

# HTTPS 部署时设为 true（Cookie 加 Secure）
PANEL_COOKIE_SECURE=false

# 会话有效期（天）
PANEL_SESSION_DAYS=30

# Li&Pass OIDC
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# 链接图标自动抓取开关（V14：受控出站，超时 5s / 并发 ≤4 / 缓存 60s / 类型白名单）
PANEL_LINK_ICON_FETCH=true

# 自动快照保留份数（V19：数据变更后写入 data/backups/，超出滚动清理）
PANEL_BACKUP_KEEP=10

# 链接健康检查开关（V21：受控出站，HEAD 优先，超时 5s / 并发 ≤4 / 缓存 60s）
PANEL_HEALTH_CHECK=true

# RP 发起登出回跳白名单（V32，逗号分隔绝对地址；为空仅允许站内相对路径）
PANEL_SSO_LOGOUT_REDIRECTS=

# Host 白名单（V34，逗号分隔，支持 *.example.com 通配；为空放行）
PANEL_ALLOWED_HOSTS=

# 登录锁定（V35：每用户名+IP 连续失败 N 次锁 M 分钟）
PANEL_LOGIN_MAX_FAILS=5
PANEL_LOGIN_LOCK_MINUTES=15

# HSTS（V39，HTTPS 部署时开启）
PANEL_HSTS=false

# ===== 前端品牌与备案（VITE_*，仅作为构建期默认值） =====
# 运行时以后台「站点信息」配置为准（site_settings），VITE_* 仅作未配置时的回退
# 备案信息：留空则页脚不显示对应链接；图标缺失时页脚显示「备/公」占位
VITE_APP_NAME=Li&Panel
VITE_APP_TAGLINE=一次收藏，触达所有常用入口
VITE_ICP_FILING_TEXT=
VITE_ICP_FILING_URL=https://beian.miit.gov.cn/
VITE_ICP_FILING_ICON=/badges/icp.webp
VITE_POLICE_FILING_TEXT=
VITE_POLICE_FILING_URL=https://beian.mps.gov.cn/
VITE_POLICE_FILING_ICON=/badges/police.webp
